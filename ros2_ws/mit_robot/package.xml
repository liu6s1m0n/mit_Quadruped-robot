<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- ROS 2 包清单：声明构建、运行和接口生成所需依赖，不包含控制参数。 -->
  <name>mymit_robot</name>
  <version>0.0.0</version>
  <description>GO1 ROS 2 interfaces, robot description, and control framework.</description>
  <maintainer email="2461405053@qq.com">simon</maintainer>
  <license>Apache-2.0</license>
  <license>BSD-3-Clause</license>

  <!-- 编译控制程序与生成自定义 msg/srv 所需的依赖。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mujoco_vendor</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- 以下依赖用于启动文件、机器人描述和可选的 ros2_control 仿真链路。 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>mujoco_ros2_control_msgs</exec_depend>
  <exec_depend>mujoco_ros2_control_plugins</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
